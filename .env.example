# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get these from Razorpay Dashboard → Settings → API Keys
# For testing, use test keys (rzp_test_...). Switch to live keys (rzp_live_...) for production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay Webhook Secret — set in Dashboard → Settings → Webhooks
# Webhook URL: https://your-domain.vercel.app/api/razorpay-webhook
# Events to enable: payment.captured, payment.authorized, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Supabase (server-side) ────────────────────────────────────────────────────
# These are used by Vercel serverless functions for DB operations
SUPABASE_URL=https://kenlnisfhrkgolvxitfc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at resend.com → get API key
# For testing, Resend allows sending from onboarding@resend.dev
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXX
FROM_EMAIL=SkillUpNow <payments@skillupnow.in>

# ── Admin Notification ────────────────────────────────────────────────────────
# Email address to receive payment notifications (admin alerts)
ADMIN_EMAIL=skillupnow.in@gmail.com
