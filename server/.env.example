# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get these from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret — set this in Dashboard → Settings → Webhooks
# Leave blank to skip signature verification (not recommended in production)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://skillupnowadmin.org,http://localhost:3000
